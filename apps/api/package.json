{
  "name": "api",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "bun run build && bun run src/server.ts",
    "build": "bun build src/lambda.ts --target=node  --outdir dist  --bundle  --minify   --format=cjs",
    "build:lambda-zip": "bun run build &&  Compress-Archive -Path dist,package.json -DestinationPath lambda.zip -Force"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1034.0",
    "@aws-sdk/client-ssm": "^3.1034.0",
    "@repo/auth": "*",
    "@repo/db": "*",
    "@types/aws-lambda": "^8.10.160",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.2",
    "serverless-http": "^4.0.0"
  }
}