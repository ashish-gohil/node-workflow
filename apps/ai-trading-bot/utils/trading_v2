def generate_signal_v2(direction, confidence, expected_return):
    """
    Convert model output → trading decision

    Args:
        direction: 0 (DOWN), 1 (UP)
        confidence: probability (0-1)
        expected_return: predicted % move

    Returns:
        signal: BUY / SELL / HOLD
        strength: STRONG / MEDIUM / WEAK
    """

    # Ignore weak predictions
    if confidence < 0.55:
        return "HOLD", "WEAK"

    # BUY logic
    if direction == 1:
        if confidence > 0.75 and expected_return > 0.015:
            return "BUY", "STRONG"
        elif confidence > 0.65 and expected_return > 0.008:
            return "BUY", "MEDIUM"
        else:
            return "HOLD", "WEAK"

    # SELL logic
    if direction == 0:
        if confidence > 0.75 and expected_return < -0.015:
            return "SELL", "STRONG"
        elif confidence > 0.65 and expected_return < -0.008:
            return "SELL", "MEDIUM"
        else:
            return "HOLD", "WEAK"

    return "HOLD", "WEAK"