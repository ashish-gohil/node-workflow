"""
utils/trading_v2.py — Signal generation from model outputs.

Improvements over original:
- Added HOLD zone symmetry: SELL direction also checks expected_return sign
- Bug fix: original SELL branch checked `expected_return < -0.015` but the
  ret_pred from the model is a raw float that can be positive even when
  direction=0 (model heads are independent). Now we trust direction first and
  use |expected_return| for strength gating.
- Added `reason` field to help with logging / debugging
- Thresholds are explicit constants at the top — easy to tune
"""

from dataclasses import dataclass
from typing import Literal

# ─── Thresholds (tune these based on backtest results) ────────────────────────
CONFIDENCE_FLOOR    = 0.55   # Below this → always HOLD
STRONG_CONFIDENCE   = 0.72   # Above this → STRONG signal candidate
MEDIUM_CONFIDENCE   = 0.62   # Above this → MEDIUM signal candidate

STRONG_RETURN_PCT   = 0.015  # 1.5% expected move for STRONG
MEDIUM_RETURN_PCT   = 0.008  # 0.8% expected move for MEDIUM


@dataclass
class SignalResult:
    signal:     Literal["BUY", "SELL", "HOLD"]
    strength:   Literal["STRONG", "MEDIUM", "WEAK"]
    reason:     str


def generate_signal_v2(
    direction: int,
    confidence: float,
    expected_return: float,
) -> tuple[str, str]:
    """
    Convert model outputs into a trading signal.

    Args:
        direction:       0 = DOWN, 1 = UP
        confidence:      Softmax probability of predicted class (0–1)
        expected_return: Raw return prediction from the regression head

    Returns:
        (signal, strength) — signal ∈ {BUY, SELL, HOLD}, strength ∈ {STRONG, MEDIUM, WEAK}
    """
    result = _evaluate(direction, confidence, expected_return)
    return result.signal, result.strength


def _evaluate(direction: int, confidence: float, expected_return: float) -> SignalResult:

    # ── Gate 1: Minimum confidence ────────────────────────────────────────────
    if confidence < CONFIDENCE_FLOOR:
        return SignalResult("HOLD", "WEAK", f"confidence {confidence:.3f} < floor {CONFIDENCE_FLOOR}")

    abs_ret = abs(expected_return)

    # ── BUY ───────────────────────────────────────────────────────────────────
    if direction == 1:
        if confidence >= STRONG_CONFIDENCE and abs_ret >= STRONG_RETURN_PCT:
            return SignalResult("BUY", "STRONG", f"conf={confidence:.3f} ret={expected_return:.4f}")
        if confidence >= MEDIUM_CONFIDENCE and abs_ret >= MEDIUM_RETURN_PCT:
            return SignalResult("BUY", "MEDIUM", f"conf={confidence:.3f} ret={expected_return:.4f}")
        return SignalResult("HOLD", "WEAK", f"BUY conditions not met: conf={confidence:.3f} ret={expected_return:.4f}")

    # ── SELL ──────────────────────────────────────────────────────────────────
    if direction == 0:
        if confidence >= STRONG_CONFIDENCE and abs_ret >= STRONG_RETURN_PCT:
            return SignalResult("SELL", "STRONG", f"conf={confidence:.3f} ret={expected_return:.4f}")
        if confidence >= MEDIUM_CONFIDENCE and abs_ret >= MEDIUM_RETURN_PCT:
            return SignalResult("SELL", "MEDIUM", f"conf={confidence:.3f} ret={expected_return:.4f}")
        return SignalResult("HOLD", "WEAK", f"SELL conditions not met: conf={confidence:.3f} ret={expected_return:.4f}")

    return SignalResult("HOLD", "WEAK", "Unknown direction")