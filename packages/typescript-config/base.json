{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    
    "module": "ESNext",
    "moduleResolution": "Bundler",
   
    "baseUrl": ".",
    "paths": {
      "@repo/db": [
        "packages/db"
      ],
      "@repo/auth": [
        "packages/auth"
      ]
    },
    
    "strict": true,
    "skipLibCheck": true,
   
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
   
    "resolveJsonModule": true,
    "isolatedModules": true,
   
    "noEmit": true
  }
}