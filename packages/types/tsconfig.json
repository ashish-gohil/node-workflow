{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "rootDir": "src",
    "outDir": "dist",

    "declaration": true,
    "declarationMap": true,

    "sourceMap": true,

    "strict": true,
    "esModuleInterop": true,

    "skipLibCheck": true,
    "moduleResolution": "bundler"
  },
  "include": ["src"]
}
